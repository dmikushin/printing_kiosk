#!/usr/bin/env python3
"""brother-safe-print - Memory-safe chunked printing for Brother DCP-1510.

Renders the input PDF to CUPS raster via a SINGLE cupsfilter invocation
(one Ghostscript process for all pages), then splits the raster at page
boundaries, measures each page's compressed brlaser size by piping
through rastertobrlaser (trivially fast — no rendering), packs pages
into memory-safe chunks, and sends each chunk as raw brlaser data via
`lp -o raw` — completely bypassing the CUPS filter chain for delivery.

This means Ghostscript runs EXACTLY ONCE regardless of document size.
A 1-page PDF has zero overhead vs plain `lp`. An 18-page PDF adds only
the chunk-send time (~3 min of USB transfers + settle pauses).
"""

import argparse
import os
import shutil
import struct
import subprocess
import sys
import tempfile
import time

QUEUE = os.environ.get("QUEUE", "Brother_DCP-1510_series")
CHUNK_BYTES = int(os.environ.get("CHUNK_BYTES", "1000000"))
SECS_PER_PAGE = int(os.environ.get("SECS_PER_PAGE", "4"))
BASE_WAIT = int(os.environ.get("BASE_WAIT", "3"))
PRIMARY_DPI = os.environ.get("PRIMARY_DPI", "600")
FALLBACK_DPI = os.environ.get("FALLBACK_DPI", "300")
PPD = os.environ.get("PPD", f"/etc/cups/ppd/{QUEUE}.ppd")
RASTERTOBRL = os.environ.get("RASTERTOBRL", "/usr/lib/cups/filter/rastertobrlaser")

# CUPS raster magics:
#   v1 BE "RaSt"  v1 LE "tSaR"
#   v2 BE "RaS2"  v2 LE "2SaR"
#   v3 BE "RaS3"  v3 LE "3SaR"
_KNOWN_MAGICS = {
    b"RaSt": ">", b"tSaR": "<",
    b"RaS2": ">", b"2SaR": "<",
    b"RaS3": ">", b"3SaR": "<",
}
_raster_magic = b"3SaR"
_raster_endian = "<"
RASTER_HDR_SIZE = 1796   # sizeof(cups_page_header2_t)
# Offsets within cups_page_header2_t for cupsWidth/Height/BytesPerLine
OFF_WIDTH = 372
OFF_HEIGHT = 376
OFF_BPL = 392


def log(msg):
    print(f"[brprint] {msg}", flush=True)


def die(msg, code=1):
    print(f"[brprint] ERROR: {msg}", file=sys.stderr, flush=True)
    sys.exit(code)


# ── 1. Render PDF → CUPS raster (single Ghostscript invocation) ─────────

def render_to_raster(pdf_path, ppd, dpi, out_path):
    """Run cupsfilter once to produce a CUPS raster file for all pages."""
    log(f"rendering all pages at {dpi}dpi via cupsfilter (single gs run)...")
    try:
        with open(out_path, "wb") as f:
            subprocess.check_call(
                ["cupsfilter", "-p", ppd,
                 "-o", f"Resolution={dpi}dpi",
                 "-m", "application/vnd.cups-raster",
                 pdf_path],
                stdout=f, stderr=subprocess.DEVNULL,
            )
    except subprocess.CalledProcessError as e:
        die(f"cupsfilter failed (exit {e.returncode})", 3)
    size = os.path.getsize(out_path)
    if size < 4:
        die("cupsfilter produced empty raster", 3)
    log(f"raster: {size:,} bytes")


# ── 2. Parse CUPS raster → per-page (offset, length) ────────────────────

def parse_raster_pages(raster_path):
    """Return list of (data_offset, header+data_length) for each page.

    data_offset is the byte position of the page header within the file.
    header+data_length = RASTER_HDR_SIZE + cupsHeight * cupsBytesPerLine.
    """
    size = os.path.getsize(raster_path)
    pages = []
    global _raster_magic, _raster_endian
    with open(raster_path, "rb") as f:
        magic = f.read(4)
        if magic not in _KNOWN_MAGICS:
            die(f"bad raster magic: {magic!r} (known: {sorted(_KNOWN_MAGICS)!r})")
        _raster_magic = magic
        _raster_endian = _KNOWN_MAGICS[magic]
        pos = 4
        while pos + RASTER_HDR_SIZE <= size:
            f.seek(pos)
            hdr = f.read(RASTER_HDR_SIZE)
            if len(hdr) < RASTER_HDR_SIZE:
                break
            cw = struct.unpack_from(_raster_endian+"I", hdr, OFF_WIDTH)[0]
            ch = struct.unpack_from(_raster_endian+"I", hdr, OFF_HEIGHT)[0]
            bpl = struct.unpack_from(_raster_endian+"I", hdr, OFF_BPL)[0]
            if cw == 0 or ch == 0 or bpl == 0:
                break
            page_data_len = ch * bpl
            page_total = RASTER_HDR_SIZE + page_data_len
            pages.append((pos, page_total))
            pos += page_total
    return pages


# ── 3. Measure brlaser byte cost per page (fast, no Ghostscript) ────────

def extract_page_raster(raster_path, page_offset, page_length, out_path):
    """Write a valid single-page CUPS raster file."""
    with open(raster_path, "rb") as fin, open(out_path, "wb") as fout:
        fout.write(_raster_magic)
        fin.seek(page_offset)
        remaining = page_length
        while remaining > 0:
            chunk = fin.read(min(remaining, 65536))
            if not chunk:
                break
            fout.write(chunk)
            remaining -= len(chunk)


def measure_brlaser(page_raster_path):
    """Pipe a single-page raster through rastertobrlaser → return byte count."""
    env = dict(os.environ, PPD=PPD, CUPS_SERVERROOT="/etc/cups")
    try:
        result = subprocess.run(
            [RASTERTOBRL, "1", "brprint", "measure", "1", "",
             page_raster_path],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            env=env, check=True,
        )
    except subprocess.CalledProcessError as e:
        die(f"rastertobrlaser failed (exit {e.returncode})", 4)
    return len(result.stdout)


def measure_all_pages(raster_path, pages):
    """Measure brlaser byte cost of each page. Returns list of sizes."""
    sizes = []
    for i, (offset, length) in enumerate(pages, 1):
        page_raster = os.path.join(work, f"p-{i}.raster")
        extract_page_raster(raster_path, offset, length, page_raster)
        s = measure_brlaser(page_raster)
        os.remove(page_raster)
        sizes.append(s)
        log(f"  page {i:2d}: {s:9,} B brlaser")
    return sizes


# ── 4. Greedy chunk packing ─────────────────────────────────────────────

def pack_chunks(sizes, budget):
    """Return list of (start_idx, end_idx) 0-based inclusive ranges."""
    if not sizes:
        return []
    chunks = []
    start = 0
    cur = sizes[0]
    for i in range(1, len(sizes)):
        if cur + sizes[i] > budget:
            chunks.append((start, i - 1))
            start = i
            cur = sizes[i]
        else:
            cur += sizes[i]
    chunks.append((start, len(sizes) - 1))
    return chunks


# ── 5. Build chunk raster and encode to brlaser ─────────────────────────

def build_chunk_raster(raster_path, pages, page_indices, out_path):
    """Build a CUPS raster containing only the selected pages."""
    with open(out_path, "wb") as fout:
        fout.write(_raster_magic)
        for idx in page_indices:
            offset, length = pages[idx]
            with open(raster_path, "rb") as fin:
                fin.seek(offset)
                remaining = length
                while remaining > 0:
                    chunk = fin.read(min(remaining, 65536))
                    if not chunk:
                        break
                    fout.write(chunk)
                    remaining -= len(chunk)


def raster_to_brlaser(raster_path, brlaser_path):
    """Pipe a multi-page raster through rastertobrlaser."""
    env = dict(os.environ, PPD=PPD, CUPS_SERVERROOT="/etc/cups")
    with open(brlaser_path, "wb") as fout:
        subprocess.check_call(
            [RASTERTOBRL, "1", "brprint", "chunk", "1", "", raster_path],
            stdout=fout, stderr=subprocess.DEVNULL, env=env,
        )


# ── 6. Send raw brlaser to printer ──────────────────────────────────────

def send_raw(brlaser_path, title):
    """Submit pre-rendered brlaser data via lp -o raw (no CUPS filters)."""
    subprocess.check_call(
        ["lp", "-d", QUEUE, "-o", "raw", "-t", title, brlaser_path],
        stdout=subprocess.DEVNULL,
    )


def wait_drain(timeout=600):
    """Wait until the CUPS queue has no active/pending jobs."""
    for _ in range(timeout):
        result = subprocess.run(
            ["lpstat", "-W", "not-completed", "-o", QUEUE],
            capture_output=True, text=True,
        )
        if not result.stdout.strip():
            return True
        time.sleep(1)
    log(f"drain timeout (>{timeout}s)")
    return False


# ── Main ─────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description="Memory-safe chunked printing for Brother DCP-1510")
    parser.add_argument("pdf", help="PDF file to print")
    parser.add_argument("--dry-run", action="store_true",
                        help="measure and plan, don't print")
    args = parser.parse_args()

    src = os.path.realpath(args.pdf)
    if not os.path.isfile(src):
        die(f"not a file: {src}")
    if not os.path.isfile(PPD):
        die(f"cannot read PPD: {PPD}")
    if not os.access(RASTERTOBRL, os.X_OK):
        die(f"missing filter: {RASTERTOBRL}")

    # Get page count
    try:
        info = subprocess.check_output(["pdfinfo", src],
                                       stderr=subprocess.DEVNULL).decode()
        npages = int([l for l in info.splitlines()
                      if l.startswith("Pages:")][0].split(":")[1])
    except Exception:
        die("pdfinfo failed or returned no page count", 2)

    log(f"source:       {src}")
    log(f"queue:        {QUEUE}")
    log(f"budget:       {CHUNK_BYTES:,} B per chunk")
    log(f"pages:        {npages}")
    if args.dry_run:
        log("*** DRY RUN ***")

    global work
    work = tempfile.mkdtemp(prefix="brprint.")
    try:
        _run(src, npages, args.dry_run)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def _run(src, npages, dry_run):
    raster_path = os.path.join(work, "full.raster")

    # ── Render once ──────────────────────────────────────────────────
    dpi = PRIMARY_DPI
    render_to_raster(src, PPD, dpi, raster_path)
    pages = parse_raster_pages(raster_path)
    if len(pages) != npages:
        log(f"warning: pdfinfo says {npages} pages but raster has {len(pages)}")
        npages = len(pages)
    if npages == 0:
        die("no pages in raster", 2)

    # ── Measure each page's brlaser cost (rastertobrlaser only, fast) ─
    log(f"measuring brlaser size per page (rastertobrlaser only, no gs)...")
    sizes = measure_all_pages(raster_path, pages)
    total = sum(sizes)
    log(f"total:        {total:,} B brlaser for {npages} pages "
        f"(avg {total // npages:,} B/page)")

    # ── DPI fallback: if ANY page exceeds budget, re-render at lower DPI
    oversize = [i for i, s in enumerate(sizes) if s > CHUNK_BYTES]
    if oversize and dpi != FALLBACK_DPI:
        log(f"{len(oversize)} page(s) exceed budget at {dpi}dpi, "
            f"re-rendering at {FALLBACK_DPI}dpi...")
        dpi = FALLBACK_DPI
        render_to_raster(src, PPD, dpi, raster_path)
        pages = parse_raster_pages(raster_path)
        npages = len(pages)
        log(f"re-measuring at {dpi}dpi...")
        sizes = measure_all_pages(raster_path, pages)
        total = sum(sizes)
        log(f"total:        {total:,} B at {dpi}dpi")
        still_over = [i for i, s in enumerate(sizes) if s > CHUNK_BYTES]
        if still_over:
            for i in still_over:
                log(f"  page {i+1}: {sizes[i]:,} B > budget {CHUNK_BYTES:,}")
            die(f"page(s) exceed budget even at {dpi}dpi", 5)

    # ── Pack chunks ──────────────────────────────────────────────────
    chunks = pack_chunks(sizes, CHUNK_BYTES)
    log(f"plan:         {len(chunks)} chunks at {dpi}dpi")
    for ci, (a, b) in enumerate(chunks, 1):
        chunk_sum = sum(sizes[a:b + 1])
        log(f"  chunk {ci:2d}: pages {a+1:2d}..{b+1:<2d}"
            f"  {chunk_sum:9,} B  ({b - a + 1} pp)")

    if dry_run:
        log("dry run complete")
        return

    # ── Send each chunk as raw brlaser ───────────────────────────────
    basename = os.path.splitext(os.path.basename(src))[0]
    for ci, (a, b) in enumerate(chunks, 1):
        npp = b - a + 1
        title = f"{basename} pp{a+1}-{b+1} @{dpi}dpi"
        log(f"chunk {ci}/{len(chunks)}: pages {a+1}..{b+1} as '{title}'")

        chunk_raster = os.path.join(work, f"chunk-{ci}.raster")
        chunk_brl = os.path.join(work, f"chunk-{ci}.brl")
        build_chunk_raster(raster_path, pages, list(range(a, b + 1)),
                           chunk_raster)
        raster_to_brlaser(chunk_raster, chunk_brl)
        os.remove(chunk_raster)

        send_raw(chunk_brl, title)
        os.remove(chunk_brl)

        log("  waiting for CUPS queue to drain...")
        wait_drain()
        settle = npp * SECS_PER_PAGE + BASE_WAIT
        log(f"  mechanical settle: {settle}s ({npp}pp x {SECS_PER_PAGE}s + {BASE_WAIT}s)")
        time.sleep(settle)

    log(f"done: {len(chunks)} chunks sent to {QUEUE}")


if __name__ == "__main__":
    main()
